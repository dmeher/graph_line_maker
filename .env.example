# Supabase is the database only. File storage lives in Cloudflare R2.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_SCHEMA=image_to_graph

# Cloudflare R2 — source and processed images.
# The app writes with the S3 API and reads through the media gateway Worker.
R2_S3_ENDPOINT=https://<cloudflare-account-id>.r2.cloudflarestorage.com
R2_BUCKET=gpm-private-prod
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Media gateway. MEDIA_GATEWAY_SIGNING_KEY must equal the Worker's
# GPM_SIGNING_KEY secret, and MEDIA_GATEWAY_URL must equal its GATEWAY_URL —
# a mismatched URL still serves correctly but silently disables edge caching.
MEDIA_GATEWAY_URL=https://files.<domain>
MEDIA_GATEWAY_SIGNING_KEY=
# Optional. Read URLs are rounded up to a bucket boundary so they stay
# byte-identical within the window, which is what makes them cacheable.
MEDIA_URL_TTL_SECONDS=3600
MEDIA_URL_BUCKET_SECONDS=3600

# Local development only. "direct" signs presigned S3 GETs straight against R2,
# so reads work with no media-gateway Worker running or deployed — point
# R2_BUCKET at a SIT bucket and MEDIA_GATEWAY_* can be left empty.
# Requires GET in the bucket CORS policy. Never use in production: these URLs
# bypass the Cloudflare edge cache, so every read is a billed Class B op.
# Defaults to "gateway".
MEDIA_READ_MODE=gateway

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Graph Pixel Maker
EMAIL_OTP_SECRET=
GRAPH_PIXEL_SESSION_SECRET=

# Local development only. Ignored unless NODE_ENV=development.
GRAPH_PIXEL_DEV_AUTH_BYPASS=false
# Optional; defaults to the bootstrap admin. Must match an active app_users row when Supabase is configured.
GRAPH_PIXEL_DEV_USER_EMAIL=
