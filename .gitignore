# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local native tool payloads are never committed.
/tools/autotrace/autotrace.exe
/tools/autotrace/*.dll


# Temporary GitIgnore for Desktop App Code
# Superseded local Python environment retained only as an ignored cache during the .NET transition.
/desktop-python/

# Native .NET build, publish, and local Playwright control artifacts.
/desktop-dotnet/**/bin/
/desktop-dotnet/**/obj/
/desktop-dotnet/publish/
/desktop-dotnet/assets/*.ico
/.playwright-cli/

# Local desktop/archive work that is outside the Graph Pixel Maker web app.
/design-archive/
/desktop-dotnet/
/output/playwright/desktop-dotnet-proposals/
/output/playwright/desktop-python-proposals/
/src/app/api/v1/
/src/lib/desktop-api.ts
/src/lib/desktop-protocol.test.ts
/src/lib/desktop-protocol.ts
